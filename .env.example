# ===== Vercel > Project > Settings > Environment Variables (Production) =====
# Never commit real values, never put them in the React code.

# --- Stripe (Dashboard > Developers) ---
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXX        # use sk_live_... only after the restaurant's account is verified
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXX      # created when you add the webhook endpoint (see README)

# --- Supabase (Project settings > API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyXXXXXXXX              # the SERVICE ROLE key, server only. NOT the anon key.

# --- Restaurant ---
KITCHEN_PASSWORD=choisissez-un-mot-de-passe-long  # password for /cuisine
PUBLIC_URL=https://www.votre-domaine.fr           # final site address, no trailing slash
DELIVERY_POSTCODES=49400                          # optional, comma separated; empty = every postcode accepted
